# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://testdb@gmail.com:testdbpassword@test.pqesk7i.mongodb.net/rafting

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=testsecret_key_1234567890

JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend origin (CORS) ────────────────────────────────────────────────────
# No trailing slash. Add comma-separated if you need more origins.
CLIENT_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:5000

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50 

# ── Gmail SMTP ────────────────────────────────────────────────────────────────

